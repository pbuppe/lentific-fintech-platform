// Schéma définitif, suite directe du Blueprint Technique V1 (§43, §65)
// Seul le package @fintech/database importe ce client Prisma (règle §01 de communication inter-modules).

generator client {
  provider      = "prisma-client-js"
  // "native" pour le développement local, "rhel-openssl-3.0.x" pour les
  // fonctions serverless de Vercel (§ déploiement démonstration) : sans les
  // deux, le moteur Prisma manque à l'exécution sur l'un des deux environnements.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identité & accès
// ---------------------------------------------------------------------------

enum Role {
  BORROWER
  INVESTOR
  AGENT
  ADMIN
  SUPER_ADMIN
}

// Cycle de vie d'un compte public (emprunteur/investisseur) — demande produit
// 2026-11-14 : e-mail confirmé PUIS validation par un administrateur avant
// tout accès à l'espace client. ACTIVE par défaut pour les comptes internes
// (agents/admins) et les comptes existants au moment de la migration.
enum AccountStatus {
  PENDING_EMAIL   // inscrit, lien de confirmation d'e-mail pas encore cliqué
  PENDING_REVIEW  // e-mail confirmé, en attente d'un administrateur
  ACTIVE          // validé : accès complet
  REJECTED        // refusé par un administrateur (motif dans accountRejectionReason)
  SUSPENDED       // accès coupé après coup
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  passwordHash     String?
  phone            String?
  countryId        String
  role             Role
  tenantId         String? // null en V1 mono-tenant, utilisé au passage SaaS B2B (§29)
  // Dernière langue d'interface utilisée en étant connecté (§ demande produit
  // 2026-09-18 : le contrat doit se générer dans la langue du visiteur, mais
  // sa génération est déclenchée par un événement serveur, pas par une page
  // en cours de rendu ; il faut donc la mémoriser plutôt que la déduire du
  // cookie au moment T). Posée par LanguageSwitcher quand une session existe,
  // et à l'inscription. Absente => français par défaut.
  preferredLocale  String?
  accountStatus          AccountStatus @default(ACTIVE)
  emailVerifiedAt        DateTime?
  accountReviewedAt      DateTime?
  accountReviewedById    String?
  accountRejectionReason String?
  emailVerificationTokens EmailVerificationToken[]
  outboundEmails   OutboundEmail[]
  borrowerProfile  BorrowerProfile?
  investorProfile  InvestorProfile?
  applications     Application[]
  investments      Investment[]
  investorListings InvestorListing[]
  introductionsSent     IntroductionRequest[] @relation("IntroductionRequester")
  introductionsReceived IntroductionRequest[] @relation("IntroductionTarget")
  documentRequestsReceived DocumentRequest[] @relation("DocumentRequestTarget")
  documentRequestsSent     DocumentRequest[] @relation("DocumentRequestRequester")
  brokerFeeRequests        BrokerFeeRequest[]
  subscription     Subscription?
  payments         Payment[]
  documents        Document[]
  notifications    Notification[] @relation("NotificationRecipient")
  notificationsSent Notification[] @relation("NotificationSender")
  accountSetupTokens AccountSetupToken[]
  assistanceAsClient AssistanceSession[] @relation("AssistanceClient")
  assistanceAsStaff  AssistanceSession[] @relation("AssistanceStaff")
  supportTickets   SupportTicket[]
  auditLogs        AuditLog[]
  sessions         Session[]
  directLoansAsBorrower DirectLoanAgreement[] @relation("DirectLoanBorrower")
  directLoansAsLender   DirectLoanAgreement[] @relation("DirectLoanLender")
  createdAt        DateTime @default(now())

  country Country @relation(fields: [countryId], references: [id])
  tenant  Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([role])
  @@index([tenantId])
  @@index([accountStatus])
}

// Lien de confirmation d'e-mail. Seule l'empreinte SHA-256 du jeton est
// stockée : une fuite de la base ne permet pas de confirmer un compte.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Journal de tous les e-mails émis par la plateforme. Sans fournisseur
// configuré (RESEND_API_KEY absent), status = LOCAL : l'e-mail n'est pas
// envoyé mais reste lisible dans le back-office (onglet "E-mails envoyés").
model OutboundEmail {
  id        String   @id @default(cuid())
  userId    String?
  to        String
  subject   String
  text      String
  html      String
  kind      String   // ex. "account.verify_email", "account.approved"
  status    String   // LOCAL | SENT | FAILED
  error     String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// Session légère maison (§ décision produit : pas de fournisseur d'auth externe
// pour l'instant, même logique que KYC/signature, voir packages/auth). Mot de
// passe haché (bcrypt) + jeton de session opaque en cookie httpOnly.
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model BorrowerProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  address      Json
  employment   Json
  income       Decimal
  expenses     Decimal
  existingDebt Decimal
  user         User    @relation(fields: [userId], references: [id])
}

enum InvestorVerificationStatus {
  UNVERIFIED      // par défaut, à l'inscription
  PENDING_REVIEW  // justificatifs déposés, en attente d'un agent
  VERIFIED
  REJECTED
}

// Vérification manuelle d'un investisseur (§ demande produit : crédibilité de
// la plateforme vis-à-vis des emprunteurs), même principe que le KYC
// emprunteur (packages/kyc) : dépôt de justificatifs, revue humaine par un
// agent depuis le back-office, jamais de prestataire tiers automatisé pour
// l'instant. Deux justificatifs attendus (type sur Document) :
// "proof_of_income" (source de revenus) et "proof_of_funds" (disponibilité
// des fonds prétendus prêtables).
model InvestorProfile {
  id                 String                      @id @default(cuid())
  userId             String                      @unique
  riskTolerance      String
  autoInvestRules    Json?
  verificationStatus InvestorVerificationStatus  @default(UNVERIFIED)
  verifiedAt         DateTime?
  rejectionReason    String?
  user               User                        @relation(fields: [userId], references: [id])
}

// ---------------------------------------------------------------------------
// Demandes & prêts
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  KYC_PENDING
  KYC_VERIFIED
  UNDER_REVIEW
  PUBLISHED
  OFFER_ACCEPTED
  CONTRACT_SIGNED
  DISBURSED
  REJECTED
  CANCELLED
}

model Application {
  id            String              @id @default(cuid())
  reference     String              @unique // APP-2026-000184
  borrowerId    String
  productId     String
  amount        Decimal
  durationMonths Int
  purpose       String
  countryId     String
  currencyId    String
  status        ApplicationStatus   @default(DRAFT)
  score         Int?
  documents     Document[]
  offers        Offer[]
  statusHistory ApplicationStatusLog[]
  disbursement  Disbursement?
  brokerFees    BrokerFeeRequest[]
  createdAt     DateTime            @default(now())

  // Option payante "Dossier Prioritaire" (49,90 €, payée d'avance au dépôt,
  // indépendamment du résultat, jamais un success-fee) : traitement sous 48h
  // garanties, suivi par slaDeadline pour la file d'attente back-office.
  priority            Boolean   @default(false)
  priorityRequestedAt DateTime?
  slaDeadline         DateTime?
  slaBreachedAt       DateTime? // posé une fois pour éviter de relancer en boucle à chaque balayage

  borrower User        @relation(fields: [borrowerId], references: [id])
  product  LoanProduct @relation(fields: [productId], references: [id])
  country  Country     @relation(fields: [countryId], references: [id])
  currency Currency    @relation(fields: [currencyId], references: [id])

  @@index([status])
  @@index([borrowerId])
}

model ApplicationStatusLog {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  actorId       String?
  createdAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Offer {
  id             String      @id @default(cuid())
  applicationId  String
  amount         Decimal
  durationMonths Int
  rate           Decimal
  status         OfferStatus @default(PENDING)
  loan           Loan?
  application    Application @relation(fields: [applicationId], references: [id])
}

model Loan {
  id                String            @id @default(cuid())
  offerId           String            @unique
  contractId        String?           @unique
  repayments        Repayment[]
  fundingOpportunity FundingOpportunity?
  offer             Offer             @relation(fields: [offerId], references: [id])
}

model LoanProduct {
  id          String        @id @default(cuid())
  code        String        @unique
  countries   String[]
  minAmount   Decimal
  maxAmount   Decimal
  active      Boolean       @default(true) // piloté par feature flag
  applications Application[]
}

// ---------------------------------------------------------------------------
// Marketplace P2P & investissement
// ---------------------------------------------------------------------------

model FundingOpportunity {
  id           String       @id @default(cuid())
  loanId       String       @unique
  targetAmount Decimal
  fundedAmount Decimal      @default(0)
  riskLevel    String
  investments  Investment[]
  loan         Loan         @relation(fields: [loanId], references: [id])
}

enum InvestorListingStatus {
  OPEN
  CLOSED
}

// Capitaux disponibles publiés par un investisseur ("j'ai 100 000 € à prêter à
// tel taux"), sens inverse de FundingOpportunity (qui porte sur un prêt déjà
// approuvé cherchant des investisseurs). Ici, c'est le capital qui est publié
// en premier, visible par les emprunteurs, avant qu'aucun dossier ne l'utilise.
// V1 : purement déclaratif, pas encore de réservation/consommation automatique
// du montant lors d'un rapprochement avec une demande.
model InvestorListing {
  id             String                @id @default(cuid())
  investorId     String
  amountAvailable Decimal
  preferredRate  Decimal
  preferredDurationMonths Int
  riskAppetite   String                @default("moderate")
  status         InvestorListingStatus @default(OPEN)
  createdAt      DateTime              @default(now())
  investor       User                  @relation(fields: [investorId], references: [id])
}

enum IntroductionTargetType {
  APPLICATION       // un investisseur demande le contact direct d'un emprunteur
  INVESTOR_LISTING  // un emprunteur demande le contact direct d'un investisseur/prêteur
}

enum IntroductionStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

// Mise en relation directe, moyennant paiement (frais fixe, 15 € par défaut),
// une fois payée, le contact (email / téléphone) est révélé dans les deux sens
// entre le demandeur et la personne visée (§ demande produit : "rendre ça plus
// accessible", particuliers comme entreprises).
model IntroductionRequest {
  id           String                 @id @default(cuid())
  requesterId  String
  targetUserId String
  targetType   IntroductionTargetType
  targetId     String
  fee          Decimal                @default(15)
  status       IntroductionStatus     @default(PENDING_PAYMENT)
  message      String?
  createdAt    DateTime               @default(now())
  paidAt       DateTime?

  requester  User @relation("IntroductionRequester", fields: [requesterId], references: [id])
  targetUser User @relation("IntroductionTarget", fields: [targetUserId], references: [id])
  directLoanAgreement DirectLoanAgreement?

  @@index([requesterId])
  @@index([targetUserId])
}

enum DirectLoanAgreementStatus {
  DRAFT              // montant/durée/taux saisis, contrat pas encore généré
  CONTRACT_GENERATED // PDF prêt, en attente de signature manuelle (même principe que Signature, §24)
  SIGNED
}

// Prêt bilatéral direct entre un emprunteur et le prêteur particulier précis
// avec qui il a été mis en relation (§ demande produit 2026-09-18), par
// opposition au parcours marketplace (Application -> Offer -> Loan,
// financement fractionné possible, Lentific "intermédiaire"). Rattaché à une
// IntroductionRequest déjà payée : ce n'est pas un nouveau canal de mise en
// relation, seulement la formalisation de ce qui, jusqu'ici, se passait
// entièrement hors plateforme une fois le contact échangé. Volontairement
// indépendant de Contract/Signature (pensés pour Loan, financement
// fractionné, risque, KYC) : ce parcours n'a ni scoring ni financement
// fractionné, le forcer dans ce modèle aurait ajouté de la complexité sans
// bénéfice.
model DirectLoanAgreement {
  id                     String                    @id @default(cuid())
  introductionRequestId  String                    @unique
  borrowerId             String
  lenderId               String
  amount                 Decimal
  durationMonths         Int
  rate                   Decimal
  status                 DirectLoanAgreementStatus @default(DRAFT)
  contractStorageKey     String?
  contractGeneratedAt    DateTime?
  signatureStorageKey    String?
  signedAt               DateTime?
  createdAt              DateTime                  @default(now())

  introductionRequest IntroductionRequest @relation(fields: [introductionRequestId], references: [id])
  borrower            User                 @relation("DirectLoanBorrower", fields: [borrowerId], references: [id])
  lender              User                 @relation("DirectLoanLender", fields: [lenderId], references: [id])

  @@index([borrowerId])
  @@index([lenderId])
}

enum InvestmentStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

model Investment {
  id            String            @id @default(cuid())
  investorId    String
  opportunityId String
  amount        Decimal
  status        InvestmentStatus  @default(ACTIVE)
  createdAt     DateTime          @default(now())
  investor      User              @relation(fields: [investorId], references: [id])
  opportunity   FundingOpportunity @relation(fields: [opportunityId], references: [id])
}

model Portfolio {
  id            String  @id @default(cuid())
  investorId    String  @unique
  totalInvested Decimal @default(0)
  totalReceived Decimal @default(0)
}

// ---------------------------------------------------------------------------
// Documents, contrats, signature
// ---------------------------------------------------------------------------

// Contenu binaire d'un fichier déposé (pièce d'identité, contrat PDF...).
// Stand-in pour un vrai bucket S3/R2 (§11, §12) : suffisant pour un
// déploiement de démonstration accessible en ligne, où un disque local ne
// survivrait pas d'une requête à l'autre sur un hébergement serverless.
// À remplacer par un vrai stockage objet avant tout usage en production réelle.
model StoredFile {
  storageKey String   @id
  content    Bytes
  createdAt  DateTime @default(now())
}

enum DocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
  EXPIRED
}

model Document {
  id            String         @id @default(cuid())
  ownerId       String
  applicationId String?
  type          String
  status        DocumentStatus @default(UPLOADED)
  storageKey    String
  version       Int            @default(1)
  expiresAt     DateTime?
  owner         User           @relation(fields: [ownerId], references: [id])
  application   Application?   @relation(fields: [applicationId], references: [id])
  fulfilledRequest DocumentRequest?
}

enum DocumentRequestStatus {
  PENDING
  FULFILLED
  CANCELLED
}

// Demande ponctuelle d'un document par un agent/super administrateur, en
// dehors des justificatifs déjà prévus par le parcours (identité, KYC
// investisseur). Donne au super administrateur un vrai pouvoir d'action sur
// un compte (§ demande produit : "plein pouvoir") : demander une pièce
// précise, et le titulaire du compte n'a plus qu'à l'uploader en réponse.
model DocumentRequest {
  id            String                @id @default(cuid())
  targetUserId  String
  requestedById String
  label         String                // ex. "Justificatif de domicile"
  instructions  String?
  status        DocumentRequestStatus @default(PENDING)
  documentId    String?               @unique
  dueAt         DateTime?             // « à fournir sous 48 h / 7 / 15 jours »
  createdAt     DateTime              @default(now())
  fulfilledAt   DateTime?

  targetUser  User      @relation("DocumentRequestTarget", fields: [targetUserId], references: [id])
  requestedBy User      @relation("DocumentRequestRequester", fields: [requestedById], references: [id])
  document    Document? @relation(fields: [documentId], references: [id])

  @@index([targetUserId])
}

model Contract {
  id              String     @id @default(cuid())
  loanId          String     @unique
  templateVersion String
  storageKey      String
  signature       Signature?
}

enum SignatureStatus {
  PENDING
  SIGNED
  DECLINED
  EXPIRED
}

model Signature {
  id         String          @id @default(cuid())
  contractId String          @unique
  provider   String
  status     SignatureStatus @default(PENDING)
  signedAt   DateTime?
  contract   Contract        @relation(fields: [contractId], references: [id])
}

// ---------------------------------------------------------------------------
// Paiements, frais, abonnements
// ---------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id         String        @id @default(cuid())
  loanId     String?
  userId     String
  amount     Decimal
  currencyId String
  type       String // disbursement | repayment | fee | payout | subscription
  status     PaymentStatus @default(PENDING)
  provider   String
  // Paiement en ligne (PayPal) : référence de la commande chez le prestataire,
  // ce que le paiement règle (broker_fee | priority) et l id concerné.
  providerRef String?      @unique
  purpose    String?
  targetId   String?
  capturedAt DateTime?
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id])
  currency   Currency      @relation(fields: [currencyId], references: [id])
}

enum RepaymentStatus {
  SCHEDULED
  PAID
  LATE
  DEFAULTED
}

model Repayment {
  id        String          @id @default(cuid())
  loanId    String
  dueDate   DateTime
  amount    Decimal
  paidAt    DateTime?
  status    RepaymentStatus @default(SCHEDULED)
  loan      Loan            @relation(fields: [loanId], references: [id])
}

model Fee {
  id        String  @id @default(cuid())
  type      String // ORIGINATION_FEE | MANAGEMENT_FEE | ...
  isFixed   Boolean
  value     Decimal
  productId String?
  countryId String?
}

enum SubscriptionStatus {
  ACTIVE     // prélèvement à jour, se renouvelle automatiquement
  CANCELLED  // résilié, reste actif jusqu'à currentPeriodEnd puis s'arrête
  PAST_DUE   // le renouvellement automatique a échoué
}

// Facturation récurrente (§ demande produit : formule Premium investisseur,
// 15 €/mois). Le prélèvement mensuel est simulé par un balayage périodique
// (voir packages/payments.processDueSubscriptions, appelé automatiquement
// par instrumentation-node.ts) qui débite currentPeriodEnd à échéance et
// avance la période, ou clôture l'abonnement si cancelledAt est déjà posé.
model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  tier             String             // ex. "INVESTOR_PREMIUM"
  amount           Decimal            @default(15)
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  // Abonnement PayPal : identifiant chez PayPal (I-…) ; null = ancien abonnement simulé.
  provider         String?
  providerRef      String?            @unique
  lastSyncedAt     DateTime?
  user             User               @relation(fields: [userId], references: [id])
}

/// Réglages techniques créés automatiquement (ex. identifiant du plan PayPal Premium).
model ProviderSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Plateforme & méta
// ---------------------------------------------------------------------------

model Country {
  id            String   @id @default(cuid())
  code          String   @unique
  currencyId    String
  defaultLocale String
  users         User[]
  applications  Application[]

  // currencyId existait déjà comme simple colonne FK sans relation Prisma
  // navigable : impossible jusqu'ici de lire la devise d'un pays depuis une
  // requête (§ marketplace géographique, badge pays/devise par annonce).
  currency Currency @relation(fields: [currencyId], references: [id])
}

model Currency {
  id           String        @id @default(cuid())
  code         String        @unique
  applications Application[]
  payments     Payment[]
  countries    Country[]
}

model Language {
  id        String @id @default(cuid())
  code      String @unique
  subdomain String @unique
}

model Rule {
  id      String  @id @default(cuid())
  key     String  @unique
  scope   Json
  value   Json
  enabled Boolean @default(true)
}

model Tenant {
  id       String @id @default(cuid())
  name     String
  branding Json
  users    User[]
}

model RoleDefinition {
  id          String       @id @default(cuid())
  name        String
  permissions Permission[]
}

model Permission {
  id       String         @id @default(cuid())
  roleId   String
  action   String
  resource String
  role     RoleDefinition @relation(fields: [roleId], references: [id])
}

// Centre de notifications de l'espace client (demande produit 2026-11-14,
// maquette Lentific « Demandes et messages ») : en plus des événements
// automatiques (event seul, libellé traduit à l'affichage), un conseiller peut
// envoyer une demande de document, de paiement ou un message. kind/title/body
// portent alors le contenu, senderId le conseiller, refId l'objet lié
// (DocumentRequest, BrokerFeeRequest) pour suivre son statut.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  channel   String
  event     String
  kind      String?   // document | payment | message | null (événement automatique)
  title     String?
  body      String?
  link      String?
  senderId  String?
  refId     String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id])
  sender    User?     @relation("NotificationSender", fields: [senderId], references: [id])

  @@index([userId, readAt])
  @@index([senderId])
}

model Conversation {
  id            String    @id @default(cuid())
  applicationId String?
  participants  String[]
  messages      Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model SupportTicket {
  id      String @id @default(cuid())
  userId  String
  status  String @default("open")
  subject String
  user    User   @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

// Suivi de visite léger, auto-hébergé (§ demande produit 2026-09-18 : un
// onglet "Statistiques" dans les comptes super admin/admin). Un vrai Matomo
// suppose soit un compte Matomo Cloud (nouveau service externe, paiement),
// soit un hébergement PHP+MySQL séparé (possible sur l'hébergement Hostinger
// déjà utilisé pour le domaine, mais pas via ce pipeline Next.js/Vercel) :
// aucun des deux ne peut être mis en place sans une action du côté de
// l'utilisateur. Ceci reste un remplacement basique en attendant, pas une
// tentative de reproduire Matomo.
model PageView {
  id          String   @id @default(cuid())
  path        String
  // Pays choisi par le visiteur (cookie NEXT_COUNTRY, dérivé de la langue du
  // navigateur) : une préférence d'affichage, pas sa vraie localisation.
  locale      String?
  countryCode String?
  // Pays réel de connexion, détecté par Vercel au niveau réseau (en-tête
  // x-vercel-ip-country), gratuit, aucun compte/service tiers requis
  // (§ demande produit 2026-09-18 : "voir le pays depuis lequel ils sont
  // connectés"). Vide en local (pas d'edge network Vercel en dev).
  geoCountryCode String?
  referrer    String?
  // Identifiant anonyme côté navigateur (cookie NEXT_VISITOR_ID, non lié à un
  // compte), seul moyen de distinguer "une personne qui a vu 5 pages" de
  // "5 personnes qui ont vu 1 page chacune" (§ demande produit 2026-09-18 :
  // visiteurs uniques par jour, visiteurs actifs sur les 30 dernières minutes).
  visitorId   String?
  // Suivi détaillé type Matomo (demande produit 2026-11-15) : visite (session
  // de navigation, 30 min d'inactivité), ville/région (en-têtes Vercel),
  // appareil déduit du navigateur, temps passé sur la page, membre connecté.
  sessionId   String?
  city        String?
  region      String?
  deviceType  String?  // mobile | tablet | desktop
  os          String?  // Android | iOS | Windows | macOS | Linux | ChromeOS
  browser     String?
  screenWidth Int?
  durationMs  Int?
  userId      String?
  utmSource   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([path])
  @@index([visitorId])
  @@index([geoCountryCode])
}

// ---------------------------------------------------------------------------
// Versement des fonds et honoraires de courtage (demande produit 2026-11-14,
// reprise de la maquette Lentific). Double validation : un admin déclare
// le versement avec une preuve (avis de déblocage), puis un SUPER_ADMIN
// différent le confirme. Les honoraires ne peuvent être demandés qu'une fois
// le versement confirmé : aucun paiement ne peut être exigé d'un emprunteur
// avant l'obtention de son prêt.
// ---------------------------------------------------------------------------

enum DisbursementStatus {
  DECLARED  // déclaré par un admin, en attente d'un super admin
  CONFIRMED // preuve contrôlée et confirmée : dossier DISBURSED
  REJECTED  // preuve refusée, l'admin doit redéclarer
}

enum FundsBeneficiary {
  BORROWER  // compte de l'emprunteur
  NOTARY    // étude notariale
  SUPPLIERS // entreprises, sur factures
}

enum FundsAvailability {
  AVAILABLE     // disponibles immédiatement
  BANK_CHECKS   // contrôles en cours à la banque
  NOTARY_CHECKS // chez le notaire, vérifications en cours
}

model Disbursement {
  id              String             @id @default(cuid())
  applicationId   String             @unique
  status          DisbursementStatus @default(DECLARED)
  beneficiary     FundsBeneficiary
  availability    FundsAvailability
  fundsDate       DateTime
  lenderReference String
  proofStorageKey String
  proofFileName   String
  declaredById    String
  declaredAt      DateTime           @default(now())
  confirmedById   String?
  confirmedAt     DateTime?
  rejectionReason String?
  availableAt     DateTime?
  application     Application        @relation(fields: [applicationId], references: [id])

  @@index([status])
}

enum BrokerFeeStatus {
  PENDING
  PAID
  CANCELLED
}

model BrokerFeeRequest {
  id            String          @id @default(cuid())
  applicationId String
  userId        String
  kind          String          // BROKER_FEE | COMPLEMENT
  amount        Decimal
  dueDate       DateTime
  status        BrokerFeeStatus @default(PENDING)
  createdById   String
  createdAt     DateTime        @default(now())
  paidAt        DateTime?
  paymentId     String?
  application   Application     @relation(fields: [applicationId], references: [id])
  user          User            @relation(fields: [userId], references: [id])

  @@index([applicationId])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Console super admin (demande produit 2026-11-14, maquette Lentific)
// ---------------------------------------------------------------------------

// Invitation d'un membre de l'équipe : le super admin crée le compte sans mot
// de passe, la personne choisit le sien via ce lien (empreinte SHA-256 seule
// en base, valable 72 h, usage unique).
model AccountSetupToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Assistance en direct : le client génère dans son espace un code à 6 chiffres
// (valable 10 min) et le donne au téléphone ; ce code vaut accord pour une
// session de 30 min pendant laquelle l'équipe agit pour lui ou le guide.
model AssistanceSession {
  id            String    @id @default(cuid())
  clientId      String
  codeHash      String
  codeExpiresAt DateTime
  problem       String?
  attempts      Int       @default(0)
  staffId       String?
  startedAt     DateTime?
  expiresAt     DateTime?
  endedAt       DateTime?
  guidance      String?   // clé du guidage affiché chez le client (sign, pay, identity, accept)
  createdAt     DateTime  @default(now())
  client        User      @relation("AssistanceClient", fields: [clientId], references: [id])
  staff         User?     @relation("AssistanceStaff", fields: [staffId], references: [id])

  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// Demandes d'étude gratuite du site vitrine (demande produit 2026-11-14,
// maquette Lentific « Demandez votre étude gratuite »). Traitées par l'équipe
// dans le back-office (onglet « Demandes de contact »).
// ---------------------------------------------------------------------------

enum ContactRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model ContactRequest {
  id          String               @id @default(cuid())
  name        String
  email       String
  phone       String
  project     String               // MORTGAGE | CONSOLIDATION | WORKS | OTHER
  amount      Decimal?
  message     String?
  locale      String?
  consentAt   DateTime
  status      ContactRequestStatus @default(NEW)
  note        String?
  handledById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// ---------------------------------------------------------------------------
// E-mailing marketing (demande produit 2026-11-15) : contacts de prospection,
// campagnes envoyées depuis le back-office (admin / super admin), suivi des
// envois et désinscription en un clic (lien dans chaque e-mail).
// ---------------------------------------------------------------------------

enum MarketingContactStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
}

// Base légale de l'envoi, exigée à l'ajout d'un contact (RGPD / ePrivacy) :
// CONSENT = la personne a accepté de recevoir nos e-mails ;
// PROFESSIONAL = adresse professionnelle, message en rapport avec son métier ;
// CLIENT = client existant, offre de services analogues.
enum MarketingLegalBasis {
  CONSENT
  PROFESSIONAL
  CLIENT
}

enum MarketingCampaignStatus {
  DRAFT
  SENDING
  SENT
}

model MarketingContact {
  id               String                 @id @default(cuid())
  email            String                 @unique
  name             String?
  locale           String                 @default("fr")
  basis            MarketingLegalBasis
  source           String                 @default("MANUAL") // MANUAL | IMPORT
  status           MarketingContactStatus @default(SUBSCRIBED)
  unsubscribeToken String                 @unique
  addedById        String?
  createdAt        DateTime               @default(now())
  unsubscribedAt   DateTime?
  sends            MarketingSend[]

  @@index([status, createdAt])
}

model MarketingCampaign {
  id           String                  @id @default(cuid())
  templateKey  String?
  locale       String                  @default("fr")
  subject      String
  body         String                  // texte brut, paragraphes séparés par une ligne vide ; {prenom} remplacé
  ctaLabel     String?
  ctaUrl       String?
  status       MarketingCampaignStatus @default(DRAFT)
  sentCount    Int                     @default(0)
  failedCount  Int                     @default(0)
  createdById  String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  sentAt       DateTime?
  sends        MarketingSend[]

  @@index([createdAt])
}

model MarketingSend {
  id         String            @id @default(cuid())
  campaignId String
  contactId  String
  status     String            // SENT | FAILED | LOCAL
  error      String?
  createdAt  DateTime          @default(now())
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    MarketingContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([createdAt])
}

// Actions des visiteurs sur le site (clics sur boutons/liens, envois de
// formulaires, liens sortants) pour le parcours de chaque visite (demande
// produit 2026-11-15). Aucune saisie de formulaire n'est enregistrée.
model TrackEvent {
  id         String   @id @default(cuid())
  visitorId  String?
  sessionId  String?
  pageViewId String?
  path       String
  kind       String   // click | submit | outbound | download
  label      String
  target     String?
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}
