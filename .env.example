# --- Base de données (Neon PostgreSQL, §57) ---
DATABASE_URL="postgresql://user:password@localhost:5432/fintech_dev"

# --- Authentification (Better Auth) ---
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# --- Paiements : Stripe (fournisseur de référence, interface interchangeable, §19) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- KYC / signature : traitement MANUEL pour l'instant (décision produit) ---
# Aucune clé nécessaire ici, voir packages/kyc et packages/signatures :
# le client dépose ses documents / son contrat signé à la main, un agent
# vérifie et confirme depuis apps/admin (/kyc et /contracts).

# --- Stockage documentaire : Cloudflare R2 (compatible S3, §11, §12) ---
DOCUMENTS_S3_ENDPOINT=""
DOCUMENTS_S3_BUCKET="fintech-documents-dev"
DOCUMENTS_S3_ACCESS_KEY_ID=""
DOCUMENTS_S3_SECRET_ACCESS_KEY=""

# --- Automatisation / événements (Inngest, §50) ---
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Apps ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
