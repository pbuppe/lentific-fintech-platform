# --- Base de données (Neon PostgreSQL, §57) ---
DATABASE_URL="postgresql://user:password@localhost:5432/fintech_dev"

# --- Authentification (Better Auth) ---
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# --- Paiements : Stripe (fournisseur de référence, interface interchangeable, §19) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- KYC / signature : traitement MANUEL pour l'instant (décision produit) ---
# Aucune clé nécessaire ici, voir packages/kyc et packages/signatures :
# le client dépose ses documents / son contrat signé à la main, un agent
# vérifie et confirme depuis apps/admin (/kyc et /contracts).

# --- Stockage documentaire : Cloudflare R2 (compatible S3, §11, §12) ---
DOCUMENTS_S3_ENDPOINT=""
DOCUMENTS_S3_BUCKET="fintech-documents-dev"
DOCUMENTS_S3_ACCESS_KEY_ID=""
DOCUMENTS_S3_SECRET_ACCESS_KEY=""

# --- Automatisation / événements (Inngest, §50) ---
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Apps ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# --- Lien secret de création de compte admin (§ demande produit 2026-09-18) ---
# Génère une vraie valeur aléatoire, longue, jamais celle-ci : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_BOOTSTRAP_TOKEN="replace-with-a-real-random-64-char-token"

# Compte de test créé le 2026-11-14 pour tester la validation des comptes (local uniquement)
# TEST_BORROWER_EMAIL=test.validation@example.com
# TEST_BORROWER_PASSWORD= (voir test-accounts.local.txt, non versionné)
# TEST_REJECTED_EMAIL=test.refus@example.com (même mot de passe)

# Envoi réel des e-mails (laisser vide en local : e-mails visibles dans le back-office > E-mails envoyés)
RESEND_API_KEY=
EMAIL_FROM=
# Comptes d'équipe de démonstration pour la double validation des versements
# (même mot de passe de démo que le seed : voir DEMO_PASSWORD dans packages/database/prisma/seed.ts) :
#   admin@lentific.com (ADMIN, déclare) · superadmin@lentific.com et superadmin2@lentific.com (SUPER_ADMIN, confirment)
# Compte d'équipe créé par invitation (test de la console super admin, 2026-11-14) :
# TEST_INVITED_ADMIN_EMAIL=julie.martin.test@example.com
# TEST_INVITED_ADMIN_PASSWORD= (voir test-accounts.local.txt, non versionné)

# Mentions légales du pied de page du site vitrine (affichées seulement si renseignées, rien n'est inventé) :
SITE_COMPANY_NAME=
SITE_ORIAS_NUMBER=
SITE_ADDRESS=
SITE_PHONE=
SITE_CONTACT_EMAIL=
SITE_MANAGER=
SITE_MEDIATOR=

# PayPal (apps/web/.env) : vide = paiement simulé
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
